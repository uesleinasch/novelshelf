<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:NovelShelf.App.ViewModels"
             xmlns:comics="using:NovelShelf.Core.Comics"
             x:Class="NovelShelf.App.Views.ComicsView"
             x:DataType="vm:ComicsViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,16">
        <TextBlock Text="Mangás, manhwas e HQs" Theme="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <StackPanel Grid.Row="1" Spacing="12">
            <ui:FAInfoBar Title="Algo deu errado" Message="{Binding Error}" Severity="Error" IsClosable="False"
                          IsOpen="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ui:FAInfoBar.ActionButton>
                    <Button Content="Tentar de novo" Command="{Binding RetryCommand}" IsVisible="{Binding IsInstalled}" />
                </ui:FAInfoBar.ActionButton>
            </ui:FAInfoBar>

            <Border IsVisible="{Binding NeedsInstall}" Padding="20" CornerRadius="8" MaxWidth="760" HorizontalAlignment="Left"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Ativar mangás e quadrinhos" Theme="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Os sites de mangá, manhwa, manhua e HQ vêm das extensões do Mihon mantidas pelo Project Nox. Elas rodam num servidor local (Suwayomi) que sobe junto com o NovelShelf e fecha quando você fecha o app. Nada fica rodando depois." />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85">
                        <Run Text="Na primeira vez o app baixa o Java 21 e o Suwayomi (cerca de" />
                        <Run Text="{Binding DownloadSizeMb}" />
                        <Run Text="MB). Os arquivos ficam na pasta de dados do NovelShelf." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding InstallCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon Symbol="Download" />
                                <TextBlock Text="Baixar e ativar" />
                            </StackPanel>
                        </Button>
                        <Button Content="Cancelar" Command="{Binding InstallCancelCommand}" IsVisible="{Binding IsInstalling}" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding IsInstalling}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallPercent}" />
                        <TextBlock Text="{Binding InstallStep}" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsStarting}">
                <ui:FAProgressRing IsIndeterminate="True" Width="22" Height="22" />
                <TextBlock Text="Iniciando o servidor de mangás..." VerticalAlignment="Center" />
            </StackPanel>

            <Grid ColumnDefinitions="220,*,Auto" IsVisible="{Binding IsReady}">
                <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                          HorizontalAlignment="Stretch" PlaceholderText="Escolha a fonte">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="comics:ComicSourceInfo">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Grid.Column="1" Margin="8,0" Text="{Binding Query}" PlaceholderText="Nome da obra">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="accent" Command="{Binding SearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Find" />
                            <TextBlock Text="Buscar" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExploreCommand}" ToolTip.Tip="Obras populares da fonte">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Globe" />
                            <TextBlock Text="Explorar" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LatestCommand}" IsVisible="{Binding CanBrowseLatest}" ToolTip.Tip="Atualizadas recentemente">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Calendar" />
                            <TextBlock Text="Novidades" />
                        </StackPanel>
                    </Button>
                    <ToggleButton IsChecked="{Binding ShowExtensions}" Command="{Binding ToggleExtensionsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Manage" />
                            <TextBlock Text="Fontes" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,16,0,0" RowDefinitions="Auto,*" IsVisible="{Binding ShowExtensionPanel}">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <TextBox Width="260" Text="{Binding ExtensionFilter}" PlaceholderText="Filtrar fontes" />
                <CheckBox Content="Todas as línguas" IsChecked="{Binding AllLanguages}" />
                <CheckBox Content="Mostrar fontes adultas (+18)" IsChecked="{Binding ShowAdult}" />
                <Button Command="{Binding RefreshExtensionsCommand}" ToolTip.Tip="Buscar a lista mais nova do Project Nox">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Atualizar lista" />
                    </StackPanel>
                </Button>
                <ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsLoadingExtensions}" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Extensions}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExtensionItemViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="96" Content="{Binding ActionText}" Command="{Binding ActCommand}"
                                    Classes.accent="{Binding !IsInstalled}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,16,0,0" ColumnDefinitions="*,380" IsVisible="{Binding ShowBrowsePanel}">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsBusy}" />
                    <TextBlock Text="Nenhuma fonte instalada. Clique em “Fontes” e instale uma." Opacity="0.75"
                               IsVisible="{Binding !HasSources}" />
                </StackPanel>
                <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComicCardViewModel">
                            <StackPanel Width="140" Spacing="6" Margin="4">
                                <Border CornerRadius="6" ClipToBounds="True" Height="200" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Author}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Content="Carregar mais" Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}"
                        HorizontalAlignment="Center" Margin="0,8,0,0" />
            </Grid>

            <Border Grid.Column="1" Margin="16,0,0,0" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    IsVisible="{Binding HasSelection}">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer>
                        <StackPanel Spacing="10">
                            <ui:FAProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" IsVisible="{Binding !HasDetails}" />
                            <StackPanel Spacing="10" IsVisible="{Binding HasDetails}">
                                <TextBlock Text="{Binding Details.Title}" Theme="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details.Author}" Opacity="0.8" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Details.ChapterCount, StringFormat='{}{0} capítulos'}" />
                                    <TextBlock Text="{Binding Details.Status}" Opacity="0.8" />
                                </StackPanel>
                                <TextBlock Text="{Binding Details.SourceName}" Opacity="0.6" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Details.Genres}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Details.Description}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="1" Classes="accent" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                            Command="{Binding AddToLibraryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Add" />
                            <TextBlock Text="Adicionar à biblioteca" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
