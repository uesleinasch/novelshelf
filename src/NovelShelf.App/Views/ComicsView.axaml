<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:NovelShelf.App.ViewModels"
             xmlns:suwayomi="using:NovelShelf.Suwayomi"
             x:Class="NovelShelf.App.Views.ComicsView"
             x:DataType="vm:ComicsViewModel">
    <Grid RowDefinitions="Auto,Auto,*" Margin="24,16">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
            <Button Margin="0,0,12,0" VerticalAlignment="Center" Command="{Binding BackToSourcesCommand}"
                    ToolTip.Tip="Voltar para as fontes">
                <Button.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding Path="ShowBrowse" />
                        <Binding Path="ShowManage" />
                        <Binding Path="ShowConfigure" />
                    </MultiBinding>
                </Button.IsVisible>
                <ui:FASymbolIcon Symbol="Back" />
            </Button>
            <TextBlock Grid.Column="1" Text="{Binding PageTitle}" Theme="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding ManageSourcesCommand}" IsVisible="{Binding ShowSources}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Manage" />
                        <TextBlock Text="Gerenciar fontes" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ConfigureSourceCommand}"
                        ToolTip.Tip="Opções da extensão desta fonte, como e-mail e senha da sua conta no site">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ShowBrowse" />
                            <Binding Path="CanConfigure" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Settings" />
                        <TextBlock Text="Configurar fonte" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenLoginCommand}"
                        ToolTip.Tip="Abre o site da fonte no navegador para você fazer login ou passar pela verificação">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ShowBrowse" />
                            <Binding Path="CanLogin" />
                        </MultiBinding>
                    </Button.IsVisible>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Globe" />
                        <TextBlock Text="Entrar no site" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="12">
            <ui:FAInfoBar Title="Algo deu errado" Message="{Binding Error}" Severity="Error" IsClosable="False"
                          IsOpen="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ui:FAInfoBar.ActionButton>
                    <Button Content="Tentar de novo" Command="{Binding RetryCommand}" IsVisible="{Binding !IsReady}" />
                </ui:FAInfoBar.ActionButton>
            </ui:FAInfoBar>

            <Border IsVisible="{Binding NeedsInstall}" Padding="20" CornerRadius="8" MaxWidth="760" HorizontalAlignment="Left"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="Ativar mangás e quadrinhos" Theme="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85"
                               Text="Os sites de mangá, manhwa, manhua e HQ vêm das extensões do Mihon mantidas pelo Project Nox. Elas rodam num servidor local (Suwayomi) que sobe junto com o NovelShelf e fecha quando você fecha o app. Nada fica rodando depois." />
                    <TextBlock TextWrapping="Wrap" Opacity="0.85">
                        <Run Text="Na primeira vez o app baixa o Java 21 e o Suwayomi (cerca de" />
                        <Run Text="{Binding DownloadSizeMb}" />
                        <Run Text="MB). Os arquivos ficam na pasta de dados do NovelShelf." />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="accent" Command="{Binding InstallCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ui:FASymbolIcon Symbol="Download" />
                                <TextBlock Text="Baixar e ativar" />
                            </StackPanel>
                        </Button>
                        <Button Content="Cancelar" Command="{Binding InstallCancelCommand}" IsVisible="{Binding IsInstalling}" />
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding IsInstalling}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding InstallPercent}" />
                        <TextBlock Text="{Binding InstallStep}" FontSize="12" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:FAInfoBar Title="Login na fonte" Message="{Binding LoginStatus}" Severity="Informational" IsClosable="False"
                          IsOpen="{Binding LoginStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsOpeningLogin}">
                <ui:FAProgressRing IsIndeterminate="True" Width="22" Height="22" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640"
                           Text="Preparando a página de login... Na primeira vez o servidor de mangás baixa um navegador (cerca de 245 MB)." />
                <Button Content="Cancelar" Command="{Binding OpenLoginCancelCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsStarting}">
                <ui:FAProgressRing IsIndeterminate="True" Width="22" Height="22" />
                <TextBlock Text="Iniciando o servidor de mangás..." VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding ShowSources}">
            <TextBlock Text="Escolha uma fonte para ver os títulos." Opacity="0.75" Margin="0,0,0,12" IsVisible="{Binding HasSources}" />
            <TextBlock Text="Nenhuma fonte instalada. Clique em “Gerenciar fontes” e instale uma." Opacity="0.75"
                       Margin="0,0,0,12" IsVisible="{Binding !HasSources}" />
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding SourceCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourceCardViewModel">
                            <Button Width="168" Height="156" Margin="0,0,12,12" Padding="12"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                    Command="{Binding $parent[ItemsControl].((vm:ComicsViewModel)DataContext).OpenSourceCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Spacing="10" VerticalAlignment="Center">
                                    <Panel Width="72" Height="72" HorizontalAlignment="Center">
                                        <Border CornerRadius="12" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                IsVisible="{Binding !HasIcon}">
                                            <TextBlock Text="{Binding Initial}" FontSize="30" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border CornerRadius="12" ClipToBounds="True" IsVisible="{Binding HasIcon}">
                                            <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                        </Border>
                                    </Panel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center"
                                               TextWrapping="Wrap" MaxLines="2" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowConfigure}">
            <TextBlock Margin="0,0,0,12" Opacity="0.75" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                       Text="Estas opções vêm da extensão da fonte. O que você salvar fica guardado no servidor de mangás, dentro da pasta de dados do NovelShelf." />
            <ScrollViewer Grid.Row="1">
                <ItemsControl ItemsSource="{Binding Preferences}" MaxWidth="760" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SourcePreferenceViewModel">
                            <Border Padding="16,12" Margin="0,0,0,8" CornerRadius="6" IsEnabled="{Binding IsEnabled}"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                                       IsVisible="{Binding HasSummary}" />
                                        </StackPanel>
                                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding IsOn}" IsVisible="{Binding IsToggle}"
                                                      OnContent="" OffContent="" />
                                    </Grid>
                                    <TextBox Text="{Binding Text}" PasswordChar="{Binding PasswordChar}"
                                             Classes.revealPasswordButton="{Binding IsSecret}" IsVisible="{Binding IsText}" />
                                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice}" MinWidth="260"
                                              IsVisible="{Binding IsList}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="suwayomi:SourceChoice">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsMultiList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SourceOptionViewModel">
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                <Button Classes="accent" Command="{Binding SavePreferencesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Save" />
                        <TextBlock Text="Salvar e recarregar a fonte" />
                    </StackPanel>
                </Button>
                <ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsLoadingPreferences}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" IsVisible="{Binding ShowManage}">
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                <TextBox Width="260" Text="{Binding ExtensionFilter}" PlaceholderText="Filtrar fontes" />
                <CheckBox Content="Todas as línguas" IsChecked="{Binding AllLanguages}" />
                <CheckBox Content="Mostrar fontes adultas (+18)" IsChecked="{Binding ShowAdult}" />
                <Button Command="{Binding RefreshExtensionsCommand}" ToolTip.Tip="Buscar a lista mais nova do Project Nox">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Atualizar lista" />
                    </StackPanel>
                </Button>
                <ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsLoadingExtensions}" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Extensions}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExtensionItemViewModel">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.7" />
                            </StackPanel>
                            <Button Grid.Column="1" MinWidth="96" Content="{Binding ActionText}" Command="{Binding ActCommand}"
                                    Classes.accent="{Binding !IsInstalled}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,380" IsVisible="{Binding ShowBrowse}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,12">
                    <TextBox Text="{Binding Query}" PlaceholderText="Buscar nesta fonte">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SearchCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ui:FASymbolIcon Symbol="Find" />
                            <TextBlock Text="Buscar" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Margin="16,0,0,0" Content="Populares" Command="{Binding PopularCommand}"
                            Classes.accent="{Binding IsPopular}" />
                    <Button Grid.Column="3" Margin="8,0,0,0" Content="Novidades" Command="{Binding LatestCommand}"
                            Classes.accent="{Binding IsLatest}" IsVisible="{Binding CanBrowseLatest}" />
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ListingLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Results.Count, StringFormat='· {0} títulos'}" Opacity="0.7" VerticalAlignment="Center" />
                    <ui:FAProgressRing IsIndeterminate="True" Width="18" Height="18" IsVisible="{Binding IsBusy}" />
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ComicCardViewModel">
                            <StackPanel Width="140" Spacing="6" Margin="4">
                                <Border CornerRadius="6" ClipToBounds="True" Height="200" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Author}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="3" HorizontalAlignment="Center" Margin="0,12,0,0" MinWidth="200"
                        Command="{Binding LoadMoreCommand}" IsVisible="{Binding HasMore}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ui:FASymbolIcon Symbol="Download" />
                        <TextBlock Text="Carregar mais" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Column="1" Margin="16,0,0,0" Padding="16" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    IsVisible="{Binding HasSelection}">
                <Grid RowDefinitions="*,Auto">
                    <ScrollViewer>
                        <StackPanel Spacing="10">
                            <ui:FAProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" IsVisible="{Binding !HasDetails}" />
                            <StackPanel Spacing="10" IsVisible="{Binding HasDetails}">
                                <TextBlock Text="{Binding Details.Title}" Theme="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Details.Author}" Opacity="0.8" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Details.ChapterCount, StringFormat='{}{0} capítulos'}" />
                                    <TextBlock Text="{Binding Details.Status}" Opacity="0.8" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Details.Genres}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding}" FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Details.Description}" TextWrapping="Wrap" Opacity="0.9" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="1" Classes="accent" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                            Command="{Binding AddToLibraryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <ui:FASymbolIcon Symbol="Add" />
                            <TextBlock Text="Adicionar à biblioteca" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
