<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:NovelShelf.App.ViewModels"
             xmlns:dev="using:NovelShelf.Devices"
             x:Class="NovelShelf.App.Views.KindleView"
             x:DataType="vm:KindleViewModel">
    <StackPanel Margin="24,16" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="Kindle" Theme="{StaticResource TitleTextBlockStyle}" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Conecte o Kindle no cabo USB e desbloqueie a tela. Os livros vão para documents/NovelShelf. Ao reenviar uma novel, o arquivo é substituído e o Kindle mantém a página onde você parou." />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="accent" Command="{Binding DetectCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Refresh" />
                    <TextBlock Text="Procurar Kindle" />
                </StackPanel>
            </Button>
            <Button Command="{Binding EjectCommand}" ToolTip.Tip="Grava o que falta e libera o Kindle para desconectar">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Upload" />
                    <TextBlock Text="Ejetar Kindle" />
                </StackPanel>
            </Button>
            <ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsSearching}" />
            <ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsEjecting}" />
        </StackPanel>
        <ui:FAInfoBar Title="Ejetar" Message="{Binding EjectMessage}" IsClosable="True"
                      Severity="{Binding EjectSeverity}"
                      IsOpen="{Binding EjectMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <ui:FAInfoBar Title="Nenhum Kindle encontrado" IsOpen="{Binding !IsConnected}" IsClosable="False" Severity="Warning"
                      Message="No Linux o Kindle aparece como disco (USB) ou como MTP no gerenciador de arquivos. Se for MTP, abra-o uma vez no Arquivos/Nautilus e procure de novo." />
        <ui:FASettingsExpander Header="Modelo do Kindle" Description="Usado para ajustar as páginas de mangás e HQs ao tamanho da tela.">
            <ui:FASettingsExpander.IconSource>
                <ui:FASymbolIconSource Symbol="Zoom" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" MinWidth="280" />
            </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
        <ui:FASettingsExpander Header="Estilo dos livros" Description="Recuo, espaço entre parágrafos, alinhamento e título dos capítulos das novels.">
            <ui:FASettingsExpander.IconSource>
                <ui:FASymbolIconSource Symbol="Font" />
            </ui:FASettingsExpander.IconSource>
            <ui:FASettingsExpander.Footer>
                <Button Content="Ajustar" Command="{Binding OpenBookStyleCommand}" />
            </ui:FASettingsExpander.Footer>
        </ui:FASettingsExpander>
        <ListBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Selected}" Background="Transparent">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dev:KindleDevice">
                    <StackPanel Spacing="2" Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Connection}" FontSize="12" Opacity="0.7" />
                        <TextBlock Text="{Binding RootPath}" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
