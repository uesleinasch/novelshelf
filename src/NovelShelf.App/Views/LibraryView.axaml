<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:NovelShelf.App.ViewModels"
             x:Class="NovelShelf.App.Views.LibraryView"
             x:DataType="vm:LibraryViewModel">
    <Grid x:Name="Root" ColumnDefinitions="320,*" RowDefinitions="Auto,*" Margin="24,16">
        <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="Biblioteca" Theme="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Command="{Binding ShowListCommand}" Classes.accent="{Binding !IsGridView}" ToolTip.Tip="Ver em lista">
                    <ui:FASymbolIcon Symbol="List" />
                </Button>
                <Button Command="{Binding ShowGridCommand}" Classes.accent="{Binding IsGridView}" ToolTip.Tip="Ver em grade de capas">
                    <ui:FASymbolIcon Symbol="ViewAll" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <TextBlock Text="Sua biblioteca está vazia. Use “Buscar novels” ou “Mangás e HQs” para adicionar a primeira."
                       TextWrapping="Wrap" Opacity="0.7" IsVisible="{Binding !HasNovels}" />
            <ListBox ItemsSource="{Binding Novels}" SelectedItem="{Binding Selected}" Background="Transparent"
                     IsVisible="{Binding !IsGridView}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,4" Background="Transparent">
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Baixar capítulos" Command="{Binding Owner.DownloadItemCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Download" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Enviar para o Kindle" Command="{Binding Owner.SendItemToKindleCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Send" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding ExportMenuHeader}" Command="{Binding Owner.ExportItemCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Folder" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Remover da biblioteca" Command="{Binding Owner.RemoveItemCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Delete" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Border Width="48" Height="68" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{Binding Novel.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Progress}" FontSize="12" Opacity="0.75" />
                                <TextBlock Text="{Binding KindleStatus}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ListBox ItemsSource="{Binding Novels}" SelectedItem="{Binding Selected}" Background="Transparent"
                     IsVisible="{Binding IsGridView}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:LibraryItemViewModel">
                        <StackPanel Width="140" Spacing="4" Margin="4" Background="Transparent">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Baixar capítulos" Command="{Binding Owner.DownloadItemCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Download" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Enviar para o Kindle" Command="{Binding Owner.SendItemToKindleCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Send" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{Binding ExportMenuHeader}" Command="{Binding Owner.ExportItemCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Folder" /></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="Remover da biblioteca" Command="{Binding Owner.RemoveItemCommand}" CommandParameter="{Binding}">
                                        <MenuItem.Icon><ui:FASymbolIcon Symbol="Delete" /></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Border Height="200" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Novel.Title}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold" ToolTip.Tip="{Binding Novel.Title}" />
                            <TextBlock Text="{Binding KindleBadge}" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KindleStatus}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" Padding="20" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                IsVisible="{Binding HasSelection}">
            <ScrollViewer>
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Width="120" Height="172" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <Image Source="{Binding Selected.Cover}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="6">
                            <TextBlock Text="{Binding Selected.Novel.Title}" Theme="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Selected.Novel.Author}" Opacity="0.8" />
                            <TextBlock Text="{Binding Selected.Progress}" />
                            <TextBlock Text="{Binding Selected.KindleStatus}" Opacity="0.8" />
                            <TextBlock Text="{Binding Selected.Novel.Status}" Opacity="0.6" />
                            <TextBlock Text="{Binding Selected.Novel.SourceName}" Opacity="0.6" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <ui:FASettingsExpander Header="Baixar capítulos" Description="{Binding DownloadDescription}">
                        <ui:FASettingsExpander.IconSource>
                            <ui:FASymbolIconSource Symbol="Download" />
                        </ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <ui:FANumberBox Value="{Binding ChaptersToDownload}" Minimum="1" Maximum="5000"
                                                SpinButtonPlacementMode="Compact" Width="130" />
                                <Button Classes="accent" Content="Baixar" Command="{Binding DownloadCommand}" />
                                <Button Content="Cancelar" Command="{Binding DownloadCancelCommand}" IsVisible="{Binding IsBusy}" />
                            </StackPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>

                    <ui:FASettingsExpander Header="Enviar para o Kindle" Description="{Binding Kindle.Summary}">
                        <ui:FASettingsExpander.IconSource>
                            <ui:FASymbolIconSource Symbol="Send" />
                        </ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Procurar Kindle" Command="{Binding Kindle.DetectCommand}" />
                                <Button Classes="accent" Content="Enviar" Command="{Binding SendToKindleCommand}" />
                                <Button Content="Ejetar" Command="{Binding EjectKindleCommand}"
                                        ToolTip.Tip="Libera o Kindle para desconectar e atualizar a biblioteca" />
                            </StackPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>

                    <ui:FASettingsExpander Header="Leitura da direita para a esquerda" IsVisible="{Binding Selected.IsComic}"
                                           Description="Ligue para mangá japonês: vira a página para a esquerda e divide páginas duplas na ordem certa.">
                        <ui:FASettingsExpander.IconSource>
                            <ui:FASymbolIconSource Symbol="Back" />
                        </ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <ToggleSwitch IsChecked="{Binding Selected.RightToLeft}" OnContent="Sim" OffContent="Não" />
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>

                    <ui:FASettingsExpander Header="{Binding ExportHeader}" Description="{Binding ExportDescription}">
                        <ui:FASettingsExpander.IconSource>
                            <ui:FASymbolIconSource Symbol="Folder" />
                        </ui:FASettingsExpander.IconSource>
                        <ui:FASettingsExpander.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Ajustar corte" Command="{Binding AdjustLayoutCommand}" IsVisible="{Binding Selected.IsComic}"
                                        ToolTip.Tip="Preview e ajuste de corte e enquadramento desta obra" />
                                <Button Content="{Binding ExportButton}" Command="{Binding ExportCommand}" />
                                <Button Content="Abrir pasta" Command="{Binding OpenBooksFolderCommand}" />
                            </StackPanel>
                        </ui:FASettingsExpander.Footer>
                    </ui:FASettingsExpander>

                    <ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum}" Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}" />

                    <ui:FAInfoBar Title="{Binding StatusTitle}" Message="{Binding StatusMessage}"
                                  IsOpen="{Binding StatusTitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  IsClosable="False" />

                    <Button Content="Remover da biblioteca" Command="{Binding RemoveCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
