<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:NovelShelf.App.ViewModels"
             x:Class="NovelShelf.App.Views.SearchView"
             x:DataType="vm:SearchViewModel">
    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,380" Margin="24,16">
        <TextBlock Grid.ColumnSpan="2" Text="Buscar novels" Theme="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />

        <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBox Text="{Binding Query}" PlaceholderText="Nome da novel ou link do Novel Mania">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="accent" Margin="8,0,0,0" Command="{Binding SearchCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Find" />
                    <TextBlock Text="Buscar" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <ui:FAProgressRing IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsBusy}" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" Background="Transparent">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:NovelCardViewModel">
                        <StackPanel Width="140" Spacing="6" Margin="4">
                            <Border CornerRadius="6" ClipToBounds="True" Height="200" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxLines="2" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Author}" Opacity="0.7" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Margin="16,0,0,0" Padding="16" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                IsVisible="{Binding HasSelection}">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <ui:FAProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" IsVisible="{Binding !HasDetails}" />
                        <StackPanel Spacing="10" IsVisible="{Binding HasDetails}">
                            <TextBlock Text="{Binding Details.Title}" Theme="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Details.Author}" Opacity="0.8" />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="{Binding Details.ChapterCount, StringFormat='{}{0} capítulos'}" />
                                <TextBlock Text="{Binding Details.Status}" Opacity="0.8" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Details.Genres}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,6,6" Padding="8,2" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Details.Synopsis}" TextWrapping="Wrap" Opacity="0.9" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <Button Grid.Row="1" Classes="accent" HorizontalAlignment="Stretch" Margin="0,12,0,0"
                        Command="{Binding AddToLibraryCommand}" IsEnabled="{Binding HasDetails}">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                        <ui:FASymbolIcon Symbol="Add" />
                        <TextBlock Text="Adicionar à biblioteca" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
